<style>
  .ft-section{padding:100px 6%;background:linear-gradient(180deg,#ffffff 0%,#f7fcf8 50%,#ffffff 100%);position:relative}
  .ft-section::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 1000px 500px at 50% 0%,rgba(22,163,74,.05) 0%,transparent 60%);pointer-events:none;z-index:0}
  .ft-section > *{position:relative;z-index:1}
  .ft-tabs{display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;max-width:1100px;margin:0 auto 3rem;padding:.5rem;background:var(--bg);border:1px solid var(--border);border-radius:16px}
  .ft-tab{display:inline-flex;align-items:center;gap:.5rem;background:transparent;border:none;color:var(--text2);padding:.7rem 1.1rem;border-radius:11px;font-size:.84rem;font-weight:600;cursor:pointer;transition:all .25s;font-family:'Inter',sans-serif}
  .ft-tab svg{width:15px;height:15px;flex-shrink:0}
  .ft-tab:hover{color:var(--text);background:rgba(22,163,74,.06)}
  .ft-tab.active{background:var(--white);color:var(--green);box-shadow:0 4px 12px rgba(22,163,74,.1),0 0 0 1px rgba(22,163,74,.15)}
  .ft-panels{position:relative;max-width:1180px;margin:0 auto;min-height:480px}
  .ft-panel{display:none;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;animation:ftFade .5s ease both}
  .ft-panel.active{display:grid}
  @keyframes ftFade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
  .ft-text h3{font-size:clamp(1.8rem,3.2vw,2.6rem);font-weight:900;color:var(--dark);letter-spacing:-1.5px;line-height:1.08;margin-bottom:2.2rem}
  .ft-feat{display:flex;gap:1rem;padding:1.1rem 0;border-top:1px solid var(--border)}
  .ft-feat:first-of-type{border-top:none;padding-top:0}
  .ft-feat-ic{flex-shrink:0;width:36px;height:36px;border-radius:10px;background:var(--green-bg);border:1px solid var(--green-border);display:flex;align-items:center;justify-content:center;color:var(--green)}
  .ft-feat-ic svg{width:16px;height:16px;fill:none;stroke-width:2}
  .ft-feat h4{font-size:1rem;font-weight:800;color:var(--dark);margin-bottom:.35rem;letter-spacing:-.2px}
  .ft-feat p{font-size:.88rem;color:var(--text2);line-height:1.6}
  /* ── Visual constellation ── */
  .ft-visual{display:flex;align-items:center;justify-content:center;min-height:460px;position:relative}
  .ft-orbit{position:relative;width:460px;height:460px;display:flex;align-items:center;justify-content:center}
  .ft-orbit-core{position:relative;z-index:3;width:96px;height:96px;border-radius:24px;background:linear-gradient(135deg,#16a34a,#052e16);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 20px 50px rgba(22,163,74,.4),0 0 0 6px rgba(22,163,74,.08),0 0 0 14px rgba(22,163,74,.04)}
  .ft-orbit-core svg{width:36px;height:36px}
  .ft-ring{position:absolute;inset:0;margin:auto;width:280px;height:280px;border:1px dashed rgba(22,163,74,.3);border-radius:50%;animation:ftSpin 60s linear infinite}
  .ft-ring-2{width:420px;height:420px;border-color:rgba(22,163,74,.15);animation-duration:90s;animation-direction:reverse}
  @keyframes ftSpin{to{transform:rotate(360deg)}}
  .ft-node{position:absolute;top:50%;left:50%;transform:translate(calc(var(--x) - 50%),calc(var(--y) - 50%));background:var(--white);border:1px solid var(--border);border-radius:999px;padding:.45rem .9rem;font-size:.76rem;font-weight:600;color:var(--text);box-shadow:0 6px 16px rgba(0,0,0,.06);white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem;animation:ftFloat 4s ease-in-out infinite;z-index:2}
  .ft-node::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(22,163,74,.15)}
  .ft-node:nth-child(2){animation-delay:.2s}.ft-node:nth-child(3){animation-delay:.4s}.ft-node:nth-child(4){animation-delay:.6s}.ft-node:nth-child(5){animation-delay:.8s}.ft-node:nth-child(6){animation-delay:1s}.ft-node:nth-child(7){animation-delay:1.2s}
  @keyframes ftFloat{0%,100%{transform:translate(calc(var(--x) - 50%),calc(var(--y) - 50%))}50%{transform:translate(calc(var(--x) - 50%),calc(var(--y) - 50% - 6px))}}
  .ft-node-won::before{background:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,.3),0 0 16px rgba(22,163,74,.5)}
  .ft-node-hot::before{background:#dc2626;box-shadow:0 0 0 3px rgba(220,38,38,.25),0 0 16px rgba(220,38,38,.4);animation:ftPulse 1.6s infinite}
  @keyframes ftPulse{0%,100%{box-shadow:0 0 0 3px rgba(220,38,38,.25),0 0 16px rgba(220,38,38,.4)}50%{box-shadow:0 0 0 6px rgba(220,38,38,.1),0 0 24px rgba(220,38,38,.6)}}
  @media(max-width:900px){
    .ft-tabs{gap:.25rem;padding:.35rem}
    .ft-tab{padding:.55rem .8rem;font-size:.76rem}
    .ft-tab svg{width:13px;height:13px}
    .ft-panel{grid-template-columns:1fr;gap:2.5rem}
    .ft-visual{min-height:340px}
    .ft-orbit{width:320px;height:320px;transform:scale(.75)}
  }
</style>

<script>
(function(){
  var tabs=document.querySelectorAll('.ft-tab');
  var panels=document.querySelectorAll('.ft-panel');
  tabs.forEach(function(t){
    t.addEventListener('click',function(){
      var idx=t.dataset.tab;
      tabs.forEach(function(x){x.classList.remove('active')});
      panels.forEach(function(p){p.classList.remove('active')});
      t.classList.add('active');
      var p=document.querySelector('.ft-panel[data-panel="'+idx+'"]');
      if(p)p.classList.add('active');
    });
  });
})();
</script>

<div class="sep"></div>

<!-- ─── ROI CALCULATOR ─── -->
<section id="roi" class="roi-section">
  <div class="centered" style="margin-bottom:3rem">
    <span class="sec-label">Calculateur</span>
    <h2 class="sec-title">Combien Empire Leads va te rapporter ?</h2>
    <p class="sec-desc">Ajuste les curseurs avec tes chiffres réels. Le ROI est calculé en temps réel.</p>
  </div>
  <div class="roi-card">
    <div class="roi-title">Calcule ton ROI</div>

    <div class="roi-inputs">
      <div class="roi-field">
        <label>Combien de clients signes-tu par mois actuellement ?</label>
        <input type="number" id="roiClients" value="2" min="0" max="100">
      </div>
      <div class="roi-field">
        <label>Chiffre d'affaires moyen par client ?</label>
        <div class="roi-input-wrap">
          <input type="number" id="roiPanier" value="3000" min="0" step="100">
          <span class="roi-unit">€</span>
        </div>
      </div>
    </div>

    <div class="roi-slider-block">
      <div class="roi-slider-head">
        <label>Boost de prospection estimé avec Empire Leads</label>
        <span class="roi-slider-val" id="roiBoostVal">+100 %</span>
      </div>
      <input type="range" id="roiBoost" min="0" max="300" value="100" class="roi-slider">
      <div class="roi-slider-axis">
        <span>0 %</span><span>Moyenne Empire</span><span>300 %</span>
      </div>
    </div>

    <div class="roi-compare">
      <div class="roi-box roi-before">
        <div class="roi-box-title">Ta situation actuelle</div>
        <div class="roi-line"><span>Clients / mois</span><strong id="roiCurClients">2</strong></div>
        <div class="roi-line"><span>CA mensuel</span><strong id="roiCurMois">6 000 €</strong></div>
        <div class="roi-line"><span>CA annuel</span><strong id="roiCurAn">72 000 €</strong></div>
      </div>
      <div class="roi-arrow">→</div>
      <div class="roi-box roi-after">
        <div class="roi-badge">Empire Leads</div>
        <div class="roi-box-title">Avec Empire (+<span id="roiPctLabel">100</span> %)</div>
        <div class="roi-line"><span>Clients / mois</span><strong id="roiNewClients">4</strong></div>
        <div class="roi-line"><span>CA mensuel</span><strong id="roiNewMois">12 000 €</strong></div>
        <div class="roi-line highlight"><span>CA supplémentaire / mois</span><strong id="roiSuppMois">+6 000 €</strong></div>
        <div class="roi-line highlight"><span>CA supplémentaire / an</span><strong id="roiSuppAn">+72 000 €</strong></div>
      </div>
    </div>

    <div class="roi-kpis">
      <div class="roi-kpi">
        <div class="roi-kpi-label">ROI sur 12 mois</div>
        <div class="roi-kpi-val" id="roiMultiple">x 60</div>
      </div>
      <div class="roi-kpi">
        <div class="roi-kpi-label">Investissement rentabilisé en</div>
        <div class="roi-kpi-val" id="roiBreakeven">1 jour</div>
      </div>
    </div>
  </div>
</section>

<style>
  .roi-section{padding:100px 6%;background:linear-gradient(180deg,#f0fdf4 0%,#ecfdf5 100%)}
  .roi-card{max-width:980px;margin:0 auto;background:linear-gradient(145deg,#0b0f0c 0%,#0f1a13 100%);border:1px solid rgba(74,222,128,.18);border-radius:20px;padding:3rem 2.5rem;box-shadow:0 30px 80px rgba(0,0,0,.25),0 0 0 1px rgba(74,222,128,.06);position:relative;overflow:hidden}
  .roi-card::before{content:"";position:absolute;top:-50%;left:-20%;width:140%;height:100%;background:radial-gradient(ellipse at center,rgba(22,163,74,.15) 0%,transparent 60%);pointer-events:none}
  .roi-title{position:relative;text-align:center;font-size:1.4rem;font-weight:800;color:#fff;margin-bottom:2.5rem;letter-spacing:-.5px}
  .roi-inputs{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem}
  .roi-field label{display:block;font-size:.78rem;color:rgba(255,255,255,.7);margin-bottom:.5rem;font-weight:500}
  .roi-field input{width:100%;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:.9rem 1rem;color:#fff;font-size:1.3rem;font-weight:700;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s}
  .roi-field input:focus{border-color:#4ade80}
  .roi-input-wrap{position:relative}
  .roi-input-wrap input{padding-right:3rem}
  .roi-unit{position:absolute;right:1rem;top:50%;transform:translateY(-50%);color:rgba(255,255,255,.5);font-size:.9rem;font-weight:600;pointer-events:none}
  .roi-slider-block{position:relative;margin-bottom:2.5rem}
  .roi-slider-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.9rem}
  .roi-slider-head label{font-size:.82rem;color:rgba(255,255,255,.7);font-weight:500}
  .roi-slider-val{font-size:1.3rem;font-weight:800;color:#4ade80;letter-spacing:-.5px}
  .roi-slider{-webkit-appearance:none;appearance:none;width:100%;height:4px;background:rgba(255,255,255,.1);border-radius:2px;outline:none}
  .roi-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:18px;height:18px;border-radius:50%;background:#4ade80;cursor:pointer;box-shadow:0 0 0 4px rgba(74,222,128,.2),0 2px 8px rgba(0,0,0,.3);transition:transform .15s}
  .roi-slider::-webkit-slider-thumb:hover{transform:scale(1.15)}
  .roi-slider::-moz-range-thumb{width:18px;height:18px;border:none;border-radius:50%;background:#4ade80;cursor:pointer;box-shadow:0 0 0 4px rgba(74,222,128,.2)}
  .roi-slider-axis{display:flex;justify-content:space-between;margin-top:.6rem;font-size:.68rem;color:rgba(255,255,255,.4);font-weight:600;letter-spacing:.5px}
  .roi-slider-axis span:nth-child(2){color:#4ade80}
  .roi-compare{position:relative;display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:stretch;margin-bottom:2rem}
  .roi-box{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.4rem 1.3rem;position:relative}
  .roi-before{color:rgba(255,180,160,.9)}
  .roi-before .roi-box-title{color:#fca5a5}
  .roi-before strong{color:#fed7aa}
  .roi-after{background:linear-gradient(145deg,rgba(22,163,74,.15) 0%,rgba(22,163,74,.06) 100%);border-color:rgba(74,222,128,.35)}
  .roi-after strong{color:#4ade80}
  .roi-box-title{font-size:.85rem;font-weight:700;margin-bottom:1rem}
  .roi-line{display:flex;justify-content:space-between;align-items:center;padding:.55rem 0;font-size:.85rem;color:rgba(255,255,255,.75);border-bottom:1px solid rgba(255,255,255,.05)}
  .roi-line:last-child{border-bottom:none}
  .roi-line strong{font-size:1rem;font-weight:800;letter-spacing:-.3px}
  .roi-line.highlight{color:#fff}
  .roi-line.highlight strong{font-size:1.1rem}
  .roi-arrow{display:flex;align-items:center;justify-content:center;color:#4ade80;font-size:1.8rem;font-weight:300}
  .roi-badge{position:absolute;top:-10px;right:14px;background:#4ade80;color:#0b0f0c;font-size:.62rem;font-weight:800;padding:.3rem .7rem;border-radius:6px;letter-spacing:1.5px;text-transform:uppercase;box-shadow:0 4px 14px rgba(74,222,128,.4)}
  .roi-kpis{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.5rem}
  .roi-kpi{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:1.5rem 1.3rem;text-align:center}
  .roi-kpi-label{font-size:.68rem;color:rgba(255,255,255,.5);font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:.6rem}
  .roi-kpi-val{font-size:2.2rem;font-weight:900;color:#4ade80;letter-spacing:-1.5px}
  @media(max-width:768px){
    .roi-card{padding:2rem 1.3rem}
    .roi-inputs{grid-template-columns:1fr}
    .roi-compare{grid-template-columns:1fr}
    .roi-arrow{transform:rotate(90deg);padding:.5rem 0}
    .roi-kpis{grid-template-columns:1fr}
  }
</style>

<script>
(function(){
  var price=99; // abonnement Empire Leads Essentiel
  function fmt(n){return Math.round(n).toLocaleString('fr-FR').replace(/,/g,' ')+' €'}
  function recalc(){
    var clients=parseFloat(document.getElementById('roiClients').value)||0;
    var panier=parseFloat(document.getElementById('roiPanier').value)||0;
    var boost=parseFloat(document.getElementById('roiBoost').value)||0;
    var pct=boost/100;
    var curMois=clients*panier;
    var curAn=curMois*12;
    var newClients=clients*(1+pct);
    var newMois=newClients*panier;
    var suppMois=newMois-curMois;
    var suppAn=suppMois*12;
    var multiple=suppAn/(price*12);
    var breakeven=suppMois>0?(price/suppMois)*30:999;
    document.getElementById('roiBoostVal').textContent='+'+boost+' %';
    document.getElementById('roiPctLabel').textContent=boost;
    document.getElementById('roiCurClients').textContent=Math.round(clients);
    document.getElementById('roiCurMois').textContent=fmt(curMois);
    document.getElementById('roiCurAn').textContent=fmt(curAn);
    document.getElementById('roiNewClients').textContent=newClients.toFixed(1).replace('.0','');
    document.getElementById('roiNewMois').textContent=fmt(newMois);
    document.getElementById('roiSuppMois').textContent='+'+fmt(suppMois);
    document.getElementById('roiSuppAn').textContent='+'+fmt(suppAn);
    document.getElementById('roiMultiple').textContent='x '+(multiple>0?Math.round(multiple):0);
    var bkTxt;
    if(breakeven<1)bkTxt='moins d\'1 jour';
    else if(breakeven<30)bkTxt=Math.round(breakeven)+' jours';
    else bkTxt=(breakeven/30).toFixed(1).replace('.0','')+' mois';
    document.getElementById('roiBreakeven').textContent=bkTxt;
  }
  ['roiClients','roiPanier','roiBoost'].forEach(function(id){
    document.getElementById(id).addEventListener('input',recalc);
  });
  recalc();
})();
</script>

<!-- ─── OFFRE DECOUVERTE INTERACTIVE ─── -->
<section class="offer-section">
  <div class="centered" style="margin-bottom:3rem">
    <span class="sec-label">Offre de lancement</span>
    <h2 class="sec-title">Commence avec un pack découverte</h2>
  </div>
  <div class="offer-wrap">
    <div class="offer-mockup">
      <div class="offer-browser">
        <div class="offer-browser-chrome">
          <span class="ob-dot"></span><span class="ob-dot"></span><span class="ob-dot"></span>
          <div class="ob-url" id="obUrl">empire-leads.fr/app</div>
        </div>
        <div class="offer-browser-body">
          <div class="offer-slide active" data-slide="0">
            <div class="os-search">
              <div class="os-input">restaurants Lyon sans site</div>
              <div class="os-btn">Scan</div>
            </div>
            <div class="os-row"><div class="os-ic" style="background:linear-gradient(135deg,#dc2626,#f97316)">LP</div><div class="os-info"><div class="os-name">Le Petit Zinc</div><div class="os-meta">01 42 56 78 90 — Paris 15e — 4.6/5</div></div><span class="os-tag">Sans site</span></div>
            <div class="os-row"><div class="os-ic" style="background:linear-gradient(135deg,#7c3aed,#6366f1)">DR</div><div class="os-info"><div class="os-name">Pizzeria Da Roberto</div><div class="os-meta">04 91 55 23 67 — Lyon 7e — 4.9/5</div></div><span class="os-tag">Sans réseaux</span></div>
            <div class="os-row"><div class="os-ic" style="background:linear-gradient(135deg,#059669,#10b981)">BM</div><div class="os-info"><div class="os-name">Brasserie du Marche</div><div class="os-meta">04 78 92 11 44 — Lyon 2e — 4.7/5</div></div><span class="os-tag">Sans site</span></div>
            <div class="os-row"><div class="os-ic" style="background:linear-gradient(135deg,#d97706,#f59e0b)">CA</div><div class="os-info"><div class="os-name">Cafe des Amis</div><div class="os-meta">04 72 41 23 90 — Lyon 1er — 4.3/5</div></div><span class="os-tag">Obsolete</span></div>
            <div class="os-foot">47 prospects trouvés en 12 sec</div>
          </div>

        <div class="ft-orbit">
          <div class="ft-orbit-core" style="background:linear-gradient(135deg,#7c3aed,#2563eb)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/></svg></div>
          <span class="ft-node" style="--x:-140px;--y:-100px">Personnalisation</span>
          <span class="ft-node" style="--x:140px;--y:-110px">Tone</span>
          <span class="ft-node" style="--x:170px;--y:30px">Longueur</span>

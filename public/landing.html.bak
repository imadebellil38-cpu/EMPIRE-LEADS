    .footer-v2 .footer-brand{grid-column:span 2}
  }
</style>

<script>
  window.addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',window.scrollY>20)});
  // Scroll reveal — auto-tag all sec-title, sec-label, sec-desc and plan cards
  (function(){
    var selectors=['.sec-label','.sec-title','.sec-desc','.ft-feat','.tm-card','.steps-item','.roi-card','.offer-card','.offer-mockup','.faq-item','.cta-big-h','.cta-giant-logo','.pc-wrap'];
    selectors.forEach(function(s){document.querySelectorAll(s).forEach(function(el){el.classList.add('reveal')})});
    if(!('IntersectionObserver' in window)){document.querySelectorAll('.reveal').forEach(function(e){e.classList.add('in')});return;}
    var obs=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target)}});
    },{threshold:.12,rootMargin:'0px 0px -80px 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){obs.observe(el)});
  })();
  // VIDEO HERO : active le mode video si le fichier /video/hero.mp4 charge correctement
  (function(){
    var hero=document.getElementById('hero-section');
    var video=document.getElementById('hero-video');
    if(!hero||!video)return;
    var activated=false;
    function activate(){if(activated)return;activated=true;hero.classList.add('has-video');}
    function fail(){hero.classList.remove('has-video');var w=hero.querySelector('.hero-video-wrap');if(w)w.style.display='none';}
    video.addEventListener('loadeddata',activate);
    video.addEventListener('canplay',activate);
    video.addEventListener('error',fail);
    // Si aucune source n'est dispo au bout de 2s, on reste sur le gradient
    setTimeout(function(){if(!activated){var hasSource=false;var sources=video.querySelectorAll('source');sources.forEach(function(s){if(s.src&&video.networkState!==3)hasSource=true;});if(!hasSource||video.readyState===0)fail();}},2000);
  })();
</script>
</body>
</html>

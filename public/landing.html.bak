  .footer-social a:hover{background:var(--green);color:#fff;border-color:var(--green);transform:translateY(-2px)}
  .footer-v2 .footer-col h4{font-size:.72rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:#fff;margin-bottom:1.2rem}
  .footer-v2 .footer-col a{display:block;color:rgba(255,255,255,.55);font-size:.88rem;margin-bottom:.7rem;transition:all .2s;padding-left:0}
  .footer-v2 .footer-col a:hover{color:#4ade80;padding-left:4px}
  .footer-v2 .footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:1.8rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
  .footer-v2 .footer-bottom p{font-size:.78rem;color:rgba(255,255,255,.45);margin:0}
  .footer-payment{display:flex;align-items:center;gap:.6rem;font-size:.72rem;color:rgba(255,255,255,.45);font-weight:500}
  @media(max-width:768px){

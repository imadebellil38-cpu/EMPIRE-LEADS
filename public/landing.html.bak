<section class="tm-section">
  <div class="centered" style="margin-bottom:3rem">
    <span class="sec-label">Témoignages</span>
    <h2 class="sec-title">Ils signent des clients<br>grâce à Empire Leads</h2>
    <div class="tm-rating">
      <span class="tm-stars">★★★★★</span>
      <span>4.9/5 · basé sur les retours clients</span>

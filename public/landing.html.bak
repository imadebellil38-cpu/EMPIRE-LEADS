<style>
  .offer-section{padding:60px 6% 100px;background:var(--bg)}
  .offer-wrap{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.15fr 1fr;gap:3rem;align-items:stretch}
  /* ── Mockup gauche ── */
  .offer-mockup{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .offer-browser{width:100%;background:#fff;border-radius:16px;box-shadow:0 25px 60px rgba(22,163,74,.12),0 10px 30px rgba(0,0,0,.08);border:1px solid var(--border);overflow:hidden;transform:perspective(1400px) rotateY(-6deg) rotateX(3deg);transition:transform .6s ease}
  .offer-browser:hover{transform:perspective(1400px) rotateY(-3deg) rotateX(1deg)}
  .offer-browser-chrome{display:flex;align-items:center;gap:7px;padding:14px 18px;background:var(--bg);border-bottom:1px solid var(--border)}
  .ob-dot{width:10px;height:10px;border-radius:50%}
  .ob-dot:nth-child(1){background:#ff5f57}.ob-dot:nth-child(2){background:#ffbd2e}.ob-dot:nth-child(3){background:#28ca41}
  .ob-url{margin-left:12px;background:#fff;border:1px solid var(--border);border-radius:6px;padding:5px 14px;font-size:.72rem;color:var(--text3);font-weight:500;min-width:200px}
  .offer-browser-body{position:relative;min-height:360px;padding:20px}
  .offer-slide{position:absolute;inset:20px;opacity:0;transition:opacity .5s ease;display:flex;flex-direction:column;gap:10px;pointer-events:none}
  .offer-slide.active{opacity:1;pointer-events:auto}
  .os-search{display:flex;gap:10px;margin-bottom:4px}
  .os-input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 14px;color:var(--green);font-size:.82rem;font-weight:600}
  .os-btn{background:var(--green);color:#fff;border-radius:8px;padding:10px 18px;font-weight:700;font-size:.78rem}
  .os-row{display:flex;align-items:center;gap:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:11px 13px;animation:osSlide .5s ease both}
  .os-row:nth-child(2){animation-delay:.05s}.os-row:nth-child(3){animation-delay:.1s}.os-row:nth-child(4){animation-delay:.15s}.os-row:nth-child(5){animation-delay:.2s}
  @keyframes osSlide{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .os-ic{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:.66rem;font-weight:800;flex-shrink:0}
  .os-info{flex:1;min-width:0}
  .os-name{font-size:.82rem;font-weight:700;color:var(--text);margin-bottom:2px}
  .os-meta{font-size:.66rem;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .os-tag{font-size:.58rem;font-weight:800;color:#dc2626;background:#fef2f2;border:1px solid #fecaca;padding:3px 8px;border-radius:5px;letter-spacing:.3px;text-transform:uppercase;flex-shrink:0}
  .os-foot{margin-top:auto;padding-top:8px;font-size:.68rem;color:var(--green);font-weight:700;text-align:center}
  .offer-dots{display:flex;gap:8px;margin-top:1.3rem;justify-content:center}
  .offer-dot{width:8px;height:8px;border-radius:50%;background:rgba(22,163,74,.25);cursor:pointer;transition:all .3s}
  .offer-dot.active{background:var(--green);width:24px;border-radius:4px}

  /* ── Offre droite ── */
  .offer-card{position:relative;background:linear-gradient(145deg,#0b4d2c 0%,#16a34a 60%,#22c55e 100%);border-radius:22px;padding:2.5rem 2.3rem;color:#fff;overflow:hidden;box-shadow:0 25px 60px rgba(22,163,74,.25)}
  .offer-glow{position:absolute;inset:0;background:radial-gradient(circle at 80% 0%,rgba(255,255,255,.25) 0%,transparent 45%);pointer-events:none}
  .offer-card > *{position:relative}
  .offer-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1.2rem}
  .offer-h{font-size:1.5rem;font-weight:800;line-height:1.1;letter-spacing:-.8px}
  .offer-prices{display:flex;flex-direction:column;align-items:flex-end;gap:2px}
  .offer-price-old{font-size:.95rem;color:rgba(255,255,255,.55);text-decoration:line-through;font-weight:600}
  .offer-price-new{font-size:2.4rem;font-weight:900;letter-spacing:-1.5px;line-height:1}
  .offer-price-new em{font-style:normal;font-size:.9rem;font-weight:600;margin-left:4px;opacity:.85}
  .offer-desc{font-size:.88rem;line-height:1.6;color:rgba(255,255,255,.85);margin-bottom:1.4rem}
  .offer-stock{display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);padding:.45rem .9rem;border-radius:999px;font-size:.78rem;font-weight:600;margin-bottom:1.4rem;backdrop-filter:blur(8px)}
  .offer-stock-dot{width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 4px rgba(74,222,128,.3);animation:pulseDot 2s infinite}
  @keyframes pulseDot{0%,100%{box-shadow:0 0 0 4px rgba(74,222,128,.3)}50%{box-shadow:0 0 0 8px rgba(74,222,128,.05)}}
  .offer-btn{display:flex;align-items:center;justify-content:space-between;gap:1rem;width:100%;background:rgba(255,255,255,.95);color:#0b4d2c;padding:.5rem .5rem .5rem 1.6rem;border-radius:999px;font-weight:800;font-size:1rem;letter-spacing:-.2px;transition:all .3s cubic-bezier(.34,1.56,.64,1);margin-bottom:1rem;box-shadow:0 10px 30px rgba(0,0,0,.2)}
  .offer-btn:hover{background:#fff;transform:translateY(-2px);box-shadow:0 15px 40px rgba(0,0,0,.3)}
  .offer-btn-circle{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#16a34a,#0b4d2c);color:#fff;transition:transform .6s cubic-bezier(.34,1.56,.64,1);position:relative}
  .offer-btn:hover .offer-btn-circle{transform:rotate(360deg) scale(1.1)}
  .offer-btn-circle::before{content:"";position:absolute;inset:-4px;border-radius:50%;border:1px dashed rgba(255,255,255,.4);animation:spinDash 8s linear infinite}
  @keyframes spinDash{to{transform:rotate(360deg)}}
  .offer-btn-arrow{font-size:1.1rem;font-weight:700}
  .offer-secure{display:flex;align-items:center;justify-content:center;gap:.4rem;font-size:.75rem;color:rgba(255,255,255,.8);font-weight:500}
  .offer-secure strong{font-weight:800;text-transform:lowercase;letter-spacing:-.3px}
  .offer-sep{height:1px;background:rgba(255,255,255,.18);margin:1.8rem 0 1.4rem}
  .offer-h4{font-size:.95rem;font-weight:800;margin-bottom:1rem;letter-spacing:-.2px}
  .offer-list{list-style:none;display:flex;flex-direction:column;gap:.7rem}
  .offer-list li{display:flex;align-items:center;gap:.75rem;font-size:.86rem;color:rgba(255,255,255,.92)}
  .offer-ck{display:flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:rgba(255,255,255,.15);color:#fff;font-weight:900;font-size:.72rem;flex-shrink:0}

  @media(max-width:900px){
    .offer-wrap{grid-template-columns:1fr;gap:2rem}
    .offer-browser{transform:none}
    .offer-browser:hover{transform:none}
    .offer-card{padding:2rem 1.5rem}
    .offer-head{flex-direction:column;align-items:stretch}
    .offer-prices{flex-direction:row;align-items:baseline;gap:.8rem}
  }
</style>

<script>
(function(){
  var slides=document.querySelectorAll('.offer-slide');
  var dots=document.querySelectorAll('.offer-dot');
  var urls=['empire-leads.fr/app — Lyon','empire-leads.fr/app — Marseille','empire-leads.fr/app — Bordeaux','empire-leads.fr/app — Nice'];
  var urlEl=document.getElementById('obUrl');
  var i=0,timer;
  function go(n){
    slides.forEach(function(s,k){s.classList.toggle('active',k===n)});
    dots.forEach(function(d,k){d.classList.toggle('active',k===n)});
    if(urlEl)urlEl.textContent=urls[n]||urls[0];
    i=n;
  }
  function loop(){timer=setInterval(function(){go((i+1)%slides.length)},3500)}
  dots.forEach(function(d){d.addEventListener('click',function(){clearInterval(timer);go(parseInt(d.dataset.go));loop()})});
  loop();
})();
</script>

<div class="sep"></div>


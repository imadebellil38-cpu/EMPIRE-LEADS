<style>
  .pricing-section{padding:100px 6%;background:var(--white)}
  .pc-wrap{max-width:1180px;margin:0 auto;border:1px solid var(--border);border-radius:20px;overflow:hidden;background:var(--white);box-shadow:0 20px 50px rgba(0,0,0,.06)}
  .pc-table{width:100%;border-collapse:collapse}
  .pc-table th,.pc-table td{padding:18px 22px;text-align:center;border-bottom:1px solid var(--border)}
  .pc-table th{background:var(--bg);vertical-align:top}
  .pc-feat-col{text-align:left!important;width:34%;min-width:240px}
  .pc-feat-th{font-size:.72rem;font-weight:800;color:var(--text3);letter-spacing:2px;text-transform:uppercase;padding-top:.5rem}
  .pc-plan-col{width:22%;position:relative;padding:28px 16px!important}
  .pc-plan-featured{background:linear-gradient(180deg,rgba(22,163,74,.08) 0%,rgba(22,163,74,.03) 100%)!important;border-left:1px solid var(--green-border);border-right:1px solid var(--green-border);position:relative}
  .pc-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--green);color:#fff;font-size:.6rem;font-weight:800;padding:.35rem .85rem;border-radius:999px;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap;box-shadow:0 4px 14px rgba(22,163,74,.3)}
  .pc-plan-name{font-size:.7rem;font-weight:800;color:var(--text3);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:.7rem}
  .pc-plan-featured .pc-plan-name{color:var(--green)}
  .pc-plan-price{margin-bottom:1.2rem;color:var(--dark)}
  .pc-plan-price strong{font-family:'Switzer','Satoshi','Inter',sans-serif;font-size:2.6rem;font-weight:900;letter-spacing:-2px;line-height:1;display:block;margin-bottom:.25rem}
  .pc-plan-price span{font-size:.75rem;color:var(--text3);font-weight:600}
  .pc-plan-btn{display:block;width:100%;padding:.75rem;border-radius:10px;font-size:.82rem;font-weight:700;transition:all .25s;text-align:center}
  .pc-plan-btn-outline{background:var(--white);border:1px solid var(--border2);color:var(--text)}
  .pc-plan-btn-outline:hover{border-color:var(--green);color:var(--green)}
  .pc-plan-btn-green{background:var(--green);color:#fff;border:none;box-shadow:0 6px 18px rgba(22,163,74,.25)}
  .pc-plan-btn-green:hover{background:#15803d;transform:translateY(-1px)}
  .pc-section-row td{background:var(--bg);text-align:left!important;font-size:.65rem;font-weight:800;color:var(--green);letter-spacing:2.5px;text-transform:uppercase;padding:14px 22px!important;border-top:1px solid var(--border)}
  .pc-table tbody td:first-child{text-align:left;color:var(--text);font-weight:500;font-size:.9rem}
  .pc-feat{display:flex;align-items:center;gap:.75rem}
  .pc-feat-ic{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:var(--green-bg);border:1px solid var(--green-border);color:var(--green);flex-shrink:0}
  .pc-feat-ic svg{width:14px;height:14px}
  .pc-ck{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:var(--green-bg);color:var(--green);font-weight:800;font-size:.85rem;border:1px solid var(--green-border)}
  .pc-x{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:#fef2f2;color:#dc2626;font-weight:800;font-size:.8rem;border:1px solid #fecaca;opacity:.7}
  .pc-cell-hl{background:rgba(22,163,74,.04)}
  .pc-table tbody tr:last-child td{border-bottom:none}
  @media(max-width:900px){
    .pc-wrap{border-radius:14px;overflow-x:auto}
    .pc-table{min-width:760px}
    .pc-table th,.pc-table td{padding:12px 14px;font-size:.82rem}
    .pc-plan-price strong{font-size:2rem}
  }
</style>


  <!-- Favicon (SVG inline — couleur Empire) -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a140f'/%3E%3Cpath d='M18 22h28v6H24v6h18v6H24v6h22v6H18z' fill='%2316a34a'/%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a140f'/%3E%3Cpath d='M18 22h28v6H24v6h18v6H24v6h22v6H18z' fill='%2316a34a'/%3E%3C/svg%3E">

  <!-- JSON-LD Schema.org — SoftwareApplication + Organization + FAQPage + BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://empire-leads.fr/#organization",
        "name": "Empire Leads",
        "alternateName": ["EmpireLeads", "Empire"],
        "url": "https://empire-leads.fr",
        "logo": {
          "@type": "ImageObject",
          "url": "https://empire-leads.fr/logo.png",
          "width": 512,
          "height": 512
        },
        "description": "Logiciel de prospection B2B qui identifie les commerces sans site ni réseaux sociaux.",
        "foundingDate": "2024",
        "founders": [{"@type": "Person", "name": "M. Morales"}],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "contact@empire-leads.fr",
          "areaServed": ["FR", "BE", "CH", "LU", "CA"],
          "availableLanguage": "French"
        },
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "FR",
          "addressRegion": "Auvergne-Rhône-Alpes",
          "addressLocality": "Grenoble"
        },
        "sameAs": [
          "https://www.linkedin.com/company/empire-leads",
          "https://www.instagram.com/empireleads",
          "https://x.com/empireleads"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://empire-leads.fr/#website",
        "url": "https://empire-leads.fr",
        "name": "Empire Leads",
        "description": "Logiciel de prospection B2B — leads qualifiés, CRM, IA",
        "publisher": {"@id": "https://empire-leads.fr/#organization"},
        "inLanguage": "fr-FR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://empire-leads.fr/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://empire-leads.fr/#software",
        "name": "Empire Leads",
        "url": "https://empire-leads.fr",
        "description": "Empire Leads est un logiciel de prospection B2B qui détecte chaque jour les commerces sans site ni réseaux sociaux, extrait leurs coordonnées complètes (téléphone, email, décideur) et les transforme en clients grâce à un CRM pipeline et une IA de pitch.",
        "applicationCategory": "BusinessApplication",
        "applicationSubCategory": "Sales Prospecting Software",
        "operatingSystem": "Web, iOS, Android",
        "inLanguage": "fr-FR",
        "offers": [
          {"@type": "Offer", "name": "Essentiel", "price": "99", "priceCurrency": "EUR", "priceValidUntil": "2026-12-31", "availability": "https://schema.org/InStock", "url": "https://empire-leads.fr/#tarifs"},
          {"@type": "Offer", "name": "Pro", "price": "349", "priceCurrency": "EUR", "priceValidUntil": "2026-12-31", "availability": "https://schema.org/InStock", "url": "https://empire-leads.fr/#tarifs"},
          {"@type": "Offer", "name": "Pack Découverte 1000 leads", "price": "289", "priceCurrency": "EUR", "availability": "https://schema.org/InStock"}
        ],
        "featureList": [
          "Recherche de prospects Google Maps",
          "Filtres sans site web / sans réseaux sociaux",
          "CRM Pipeline 6 étapes",
          "Pitch IA personnalisé",
          "Instagram Finder (commentateurs, followers)",
          "Leads Chauds temps réel",
          "Email Finder & vérification SMTP",
          "Export CSV illimité",
          "Notes vocales & rappels",
          "Analytics & dashboard"
        ],
        "screenshot": "https://empire-leads.fr/screenshot.png",
        "author": {"@id": "https://empire-leads.fr/#organization"}
      },
      {
        "@type": "FAQPage",
        "@id": "https://empire-leads.fr/#faq",
        "mainEntity": [
          {"@type": "Question", "name": "Qu'est-ce qu'Empire Leads ?", "acceptedAnswer": {"@type": "Answer", "text": "Empire Leads est un logiciel de prospection B2B. Vous indiquez un secteur et une ville, et l'outil identifie les entreprises avec leurs coordonnées complètes (téléphone, email, décideur). Un pipeline CRM intégré vous permet de suivre chaque opportunité jusqu'à la signature."}},
          {"@type": "Question", "name": "D'où proviennent les données ?", "acceptedAnswer": {"@type": "Answer", "text": "Exclusivement de sources publiques : fiches Google Maps, sites internet, pages de réseaux sociaux, annuaires professionnels. L'ensemble est 100% conforme au RGPD. Aucune donnée privée n'est collectée."}},
          {"@type": "Question", "name": "Combien de prospects je reçois par mois ?", "acceptedAnswer": {"@type": "Answer", "text": "Plan Essentiel : jusqu'à 200 recherches/mois (soit ~2000 prospects). Plan Pro : recherches illimitées (20 000+ prospects/mois). Le pack découverte : 1000 prospects qualifiés livrés en 24h pour 289 €."}},
          {"@type": "Question", "name": "Puis-je annuler à tout moment ?", "acceptedAnswer": {"@type": "Answer", "text": "Oui, sans condition. Aucun frais de résiliation, aucune période d'engagement minimum. Résiliation en 1 clic depuis votre compte."}},
          {"@type": "Question", "name": "Dans quels pays le service est-il disponible ?", "acceptedAnswer": {"@type": "Answer", "text": "France, Belgique, Suisse, Luxembourg, Canada francophone et tous les pays couverts par Google Maps."}},
          {"@type": "Question", "name": "Comment démarrer ?", "acceptedAnswer": {"@type": "Answer", "text": "Créez un compte gratuit, sans carte bancaire. Lancez votre première recherche en moins de 2 minutes."}},
          {"@type": "Question", "name": "Qu'est-ce que l'Instagram Finder ?", "acceptedAnswer": {"@type": "Answer", "text": "Un outil qui extrait les audiences de n'importe quel compte Instagram : commentateurs, abonnés, likers d'un post. Vous identifiez des prospects qualifiés directement depuis les réseaux sociaux."}},
          {"@type": "Question", "name": "Que sont les Leads Chauds ?", "acceptedAnswer": {"@type": "Answer", "text": "Des projets publiés par des entreprises qui recherchent activement un prestataire. Des prospects à très forte intention d'achat, identifiés et mis à jour en temps réel."}}
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://empire-leads.fr/#breadcrumb",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://empire-leads.fr/"},
          {"@type": "ListItem", "position": 2, "name": "Fonctionnalités", "item": "https://empire-leads.fr/#fonctionnalites"},
          {"@type": "ListItem", "position": 3, "name": "Tarifs", "item": "https://empire-leads.fr/#tarifs"}
        ]
      }
    ]
  }
  </script>

  <!-- Performance : préconnexions et DNS-prefetch -->
  <link rel="dns-prefetch" href="//i.pravatar.cc">
  <link rel="dns-prefetch" href="//api.fontshare.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&f[]=switzer@500,600,700,800,900&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --white:#ffffff;--bg:#fafafa;--surface:#f4f4f5;
      --card:#ffffff;--border:#e4e4e7;--border2:#d4d4d8;
      --green:#16a34a;--green-light:#22c55e;--green-bg:rgba(22,163,74,.06);--green-border:rgba(22,163,74,.18);
      --dark:#09090b;--text:#18181b;--text2:#52525b;--text3:#a1a1aa;
      --radius:12px;
      --shadow:0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
      --shadow-lg:0 10px 40px rgba(0,0,0,.08);
    }
    html{scroll-behavior:smooth}
    body{background:var(--white);color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    /* Scroll reveal animations */
    .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.2,.6,.2,1),transform .8s cubic-bezier(.2,.6,.2,1)}
    .reveal.in{opacity:1;transform:translateY(0)}
    .reveal-delay-1{transition-delay:.08s}
    .reveal-delay-2{transition-delay:.16s}
    .reveal-delay-3{transition-delay:.24s}
    @media (prefers-reduced-motion:reduce){
      .reveal{opacity:1;transform:none}
      *{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important}
    }
    /* Satoshi body + Clash Display pour les gros titres (look Atrakt) */
    body{font-family:'Satoshi','Inter',system-ui,-apple-system,sans-serif}
    h3,h4,.ft-feat h4,.offer-h4,.steps-h,.ft-text h3{font-family:'Satoshi','Inter',system-ui,sans-serif;letter-spacing:-.015em}
    h1,h2,.hero h1,.sec-title,.steps-title,.offer-h,.cta h2,.cta-big-h,.roi-title,.cta-giant-logo{font-family:'Switzer','Satoshi','Inter',system-ui,sans-serif;letter-spacing:-.028em;font-weight:800}
    /* Scribble underline sur un mot — effet dessin manuel */
    .scribble{position:relative;display:inline-block;white-space:nowrap}
    .scribble::after{content:"";position:absolute;left:-6%;right:-6%;bottom:-.08em;height:.42em;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 40' preserveAspectRatio='none'><path d='M5 25 Q 75 5 150 18 T 295 22' stroke='%2316a34a' stroke-width='10' fill='none' stroke-linecap='round' opacity='0.55'/><path d='M10 30 Q 80 10 155 23 T 290 27' stroke='%2316a34a' stroke-width='6' fill='none' stroke-linecap='round' opacity='0.4'/></svg>");background-repeat:no-repeat;background-size:100% 100%;z-index:-1;pointer-events:none}
    .hero.has-video .scribble::after{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 40' preserveAspectRatio='none'><path d='M5 25 Q 75 5 150 18 T 295 22' stroke='%234ade80' stroke-width='10' fill='none' stroke-linecap='round' opacity='0.7'/><path d='M10 30 Q 80 10 155 23 T 290 27' stroke='%234ade80' stroke-width='6' fill='none' stroke-linecap='round' opacity='0.5'/></svg>")}

    /* ─── NAV ─── */
    nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 6%;height:68px;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.85);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);transition:box-shadow .3s}
    nav.scrolled{box-shadow:0 1px 12px rgba(0,0,0,.06)}
    .logo{display:flex;align-items:baseline;gap:3px;font-size:1.05rem;font-weight:800;letter-spacing:-.3px}
    .logo-dark{color:var(--dark)}.logo-green{color:var(--green)}
    .nav-links{display:flex;gap:2rem}
    .nav-links a{color:var(--text2);font-size:.84rem;font-weight:500;transition:color .2s}
    .nav-links a:hover{color:var(--green)}
    .nav-right{display:flex;gap:.6rem;align-items:center}
    .btn-s{padding:.48rem 1.1rem;border-radius:8px;font-size:.84rem;font-weight:600;transition:all .2s;cursor:pointer}
    .btn-ghost{background:transparent;border:1px solid var(--border);color:var(--text2)}
    .btn-ghost:hover{border-color:var(--green);color:var(--green)}
    .btn-green{background:var(--green);border:none;color:#fff}
    .btn-green:hover{background:#15803d}

    /* ─── HERO ─── */
    .hero{padding:140px 6% 80px;text-align:center;position:relative;overflow:hidden;background:linear-gradient(180deg,#f0fdf4 0%,#ffffff 50%,var(--bg) 100%)}
    /* Video background slot — active quand .has-video est sur .hero */
    .hero-video-wrap{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none;display:none}
    .hero.has-video .hero-video-wrap{display:block}
    .hero-video{position:absolute;top:50%;left:50%;min-width:100%;min-height:100%;width:auto;height:auto;transform:translate(-50%,-50%);object-fit:cover}
    .hero-video-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,20,15,.55) 0%,rgba(10,20,15,.70) 60%,rgba(10,20,15,.95) 100%);z-index:1}
    .hero-inner{position:relative;z-index:2}
    /* Quand une video est active : texte en blanc */
    .hero.has-video h1{color:#fff}
    .hero.has-video h1 em{color:#4ade80}
    .hero.has-video .hero-desc{color:rgba(255,255,255,.88)}
    .hero.has-video .hero-desc strong{color:#fff}
    .hero.has-video .hero-sub{color:rgba(255,255,255,.6)}
    .hero.has-video .btn-hero-outline{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.3);color:#fff;backdrop-filter:blur(8px)}
    .hero.has-video .btn-hero-outline:hover{background:rgba(255,255,255,.15);border-color:#4ade80;color:#fff}

    /* ─── MOCKUP DARK GLASS (quand video active) ─── */
    .hero.has-video .hero-mockup{background:rgba(15,20,18,.55);border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.04) inset}
    .hero.has-video .hm-chrome{background:rgba(255,255,255,.03);border-bottom:1px solid rgba(255,255,255,.06)}
    .hero.has-video .hm-url{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.08);color:rgba(255,255,255,.55)}
    .hero.has-video .hm-body{background:transparent}
    .hero.has-video .hm-input{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08);color:#4ade80}
    .hero.has-video .hm-row,.hero.has-video .hm-col,.hero.has-video .hm-card{background:rgba(255,255,255,.03);border-color:rgba(255,255,255,.07)}
    .hero.has-video .hm-card.hl{background:rgba(22,163,74,.12);border-color:rgba(74,222,128,.35)}
    .hero.has-video .hm-name,.hero.has-video .hm-card-name{color:#fff}
    .hero.has-video .hm-meta,.hero.has-video .hm-card-meta{color:rgba(255,255,255,.5)}
    .hero.has-video .hm-col-h{color:rgba(255,255,255,.4);border-bottom-color:rgba(255,255,255,.07)}
    .hero.has-video .hm-col-h.won{color:#4ade80}
    .hero.has-video .hm-label{color:#4ade80}
    .hero.has-video .hm-footer{color:rgba(255,255,255,.45)}
    .hero.has-video .hm-tabs{background:rgba(255,255,255,.03);border-top-color:rgba(255,255,255,.06)}
    .hero.has-video .hm-tab{color:rgba(255,255,255,.5)}
    .hero.has-video .hm-tab:hover{color:#fff}
    .hero.has-video .hm-tab.active{color:#4ade80;background:rgba(22,163,74,.15);border-color:rgba(74,222,128,.3)}
    .hero.has-video .hm-badge-red{background:rgba(220,38,38,.15);color:#fca5a5;border-color:rgba(220,38,38,.3)}
    .hero.has-video .hm-badge-green{background:rgba(22,163,74,.15);color:#86efac;border-color:rgba(22,163,74,.3)}
    .hero.has-video .hm-badge-blue{background:rgba(37,99,235,.15);color:#93c5fd;border-color:rgba(37,99,235,.3)}
    .hero.has-video .hm-badge-purple{background:rgba(124,58,237,.15);color:#c4b5fd;border-color:rgba(124,58,237,.3)}
    .hero.has-video .hm-slide p strong{color:#fff!important}
    .hero.has-video .hm-slide p{color:rgba(255,255,255,.7)!important}
    .hero.has-video .hm-slide > div[style*="background:var(--bg)"]{background:rgba(255,255,255,.03)!important;border-color:rgba(255,255,255,.07)!important}
    .hero h1{font-size:clamp(2.2rem,5vw,3.8rem);font-weight:900;line-height:1.08;letter-spacing:-2px;color:var(--dark);margin-bottom:1.5rem}
    .hero h1 em{font-style:normal;color:var(--green)}
    .hero-desc{font-size:1.05rem;line-height:1.75;color:var(--text2);max-width:560px;margin:0 auto 2.5rem}
    .hero-desc strong{color:var(--text);font-weight:600}
    .hero-actions{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin-bottom:2rem}
    .btn-hero{padding:.9rem 2.2rem;border-radius:10px;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .25s;display:inline-flex;align-items:center;gap:.5rem}
    .btn-hero-green{background:var(--green);color:#fff;border:none;box-shadow:0 4px 14px rgba(22,163,74,.25)}
    .btn-hero-green:hover{background:#15803d;box-shadow:0 6px 20px rgba(22,163,74,.3);transform:translateY(-1px)}
    .btn-hero-outline{background:var(--white);border:1px solid var(--border2);color:var(--text)}
    .btn-hero-outline:hover{border-color:var(--green);color:var(--green)}
    .hero-sub{font-size:.82rem;color:var(--text3);margin-bottom:3rem}
    .hero-sub span{margin:0 .8rem}

    /* ─── MOCKUP HERO ─── */
    .hero-mockup{max-width:920px;margin:0 auto;border-radius:16px;border:1px solid var(--border);background:var(--white);box-shadow:var(--shadow-lg);overflow:hidden}
    .hm-chrome{display:flex;align-items:center;gap:7px;padding:12px 16px;background:var(--bg);border-bottom:1px solid var(--border)}
    .hm-dot{width:9px;height:9px;border-radius:50%}
    .hm-dot:nth-child(1){background:#ff5f57}.hm-dot:nth-child(2){background:#ffbd2e}.hm-dot:nth-child(3){background:#28ca41}
    .hm-url{margin-left:12px;background:var(--white);border:1px solid var(--border);border-radius:6px;padding:4px 14px;font-size:.7rem;color:var(--text3);font-weight:500}
    .hm-body{padding:24px;min-height:360px;position:relative;overflow:hidden;background:var(--white)}
    .hm-slide{position:absolute;inset:24px;opacity:0;transition:opacity .6s ease;display:flex;flex-direction:column;gap:12px}
    .hm-slide.active{opacity:1}
    /* Search row */
    .hm-search{display:flex;gap:10px}
    .hm-input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:11px 16px;color:var(--green);font-size:.85rem;font-weight:600;font-family:'Inter',monospace}
    .hm-btn{background:var(--green);color:#fff;border:none;border-radius:8px;padding:11px 20px;font-weight:700;font-size:.8rem}
    /* Result */
    .hm-row{display:flex;align-items:center;gap:14px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:13px 16px;animation:slideUp .4s ease both}
    .hm-row:nth-child(3){animation-delay:.1s}.hm-row:nth-child(4){animation-delay:.2s}.hm-row:nth-child(5){animation-delay:.3s}.hm-row:nth-child(6){animation-delay:.4s}
    @keyframes slideUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    .hm-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:800;color:#fff;flex-shrink:0}
    .hm-info{flex:1}.hm-name{font-size:.84rem;font-weight:700;color:var(--text)}.hm-meta{font-size:.7rem;color:var(--text3);margin-top:2px}
    .hm-badges{display:flex;gap:5px;flex-shrink:0}
    .hm-badge{font-size:.58rem;padding:3px 8px;border-radius:5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase}
    .hm-badge-red{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
    .hm-badge-green{background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0}
    .hm-badge-blue{background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe}
    .hm-badge-purple{background:#faf5ff;color:#7c3aed;border:1px solid #ddd6fe}
    /* Pipeline */
    .hm-pipeline{display:flex;gap:10px;flex:1}
    .hm-col{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:7px}
    .hm-col-h{font-size:.6rem;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:1.5px;padding-bottom:7px;border-bottom:1px solid var(--border);text-align:center}
    .hm-col-h.won{color:var(--green)}
    .hm-card{background:var(--white);border:1px solid var(--border);border-radius:7px;padding:9px;animation:slideUp .4s ease both}
    .hm-card-name{font-size:.7rem;font-weight:700;color:var(--text);margin-bottom:2px}
    .hm-card-meta{font-size:.6rem;color:var(--text3)}
    .hm-card.hl{border-color:var(--green-border);background:var(--green-bg)}
    .hm-label{font-size:.78rem;color:var(--green);font-weight:700;margin-bottom:4px}
    .hm-footer{position:absolute;bottom:8px;left:24px;font-size:.68rem;color:var(--text3);font-weight:600}
    /* Tabs */
    .hm-tabs{display:flex;justify-content:center;gap:4px;padding:14px 20px;background:var(--bg);border-top:1px solid var(--border)}
    .hm-tab{font-size:.74rem;color:var(--text3);font-weight:600;cursor:pointer;padding:7px 16px;border-radius:8px;transition:all .2s;border:1px solid transparent}
    .hm-tab.active{color:var(--green);background:var(--green-bg);border-color:var(--green-border)}
    .hm-tab:hover{color:var(--text)}

    /* ─── SECTION ─── */
    section{padding:100px 6%}
    .sec-label{display:block;font-size:.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--green);margin-bottom:.6rem}
    .sec-title{font-size:clamp(1.6rem,2.8vw,2.4rem);font-weight:800;letter-spacing:-1.2px;line-height:1.12;color:var(--dark);margin-bottom:.7rem}
    .sec-desc{color:var(--text2);font-size:.92rem;line-height:1.75;max-width:500px}
    .centered{text-align:center}.centered .sec-desc{margin:0 auto}
    .sep{height:1px;background:var(--border);margin:0 6%}

    /* ─── SPLIT SECTIONS (text left, visual right) ─── */
    .split{display:flex;align-items:center;gap:4rem;flex-wrap:wrap}
    .split-text{flex:1;min-width:300px}
    .split-visual{flex:1;min-width:300px}
    .split-visual-card{background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:28px;box-shadow:var(--shadow)}
    .split.reverse{flex-direction:row-reverse}

    /* ─── FEATURES GRID ─── */
    .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.25rem;margin-top:3rem}
    .feat{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:2rem;transition:all .3s}
    .feat:hover{border-color:var(--green-border);box-shadow:var(--shadow)}
    .feat-ic{width:42px;height:42px;border-radius:10px;background:var(--green-bg);border:1px solid var(--green-border);display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem}
    .feat-ic svg{width:18px;height:18px;stroke:var(--green);fill:none;stroke-width:2}
    .feat h3{font-size:.95rem;font-weight:700;color:var(--dark);margin-bottom:.4rem}
    .feat p{font-size:.84rem;color:var(--text2);line-height:1.7}

    /* ─── STEPS ─── */
    .steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:3rem}
    .step{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:2rem;transition:all .3s}
    .step:hover{border-color:var(--green-border);box-shadow:var(--shadow)}
    .step-num{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:var(--green-bg);border:1px solid var(--green-border);color:var(--green);font-size:.8rem;font-weight:800;margin-bottom:1rem}
    .step h3{font-size:1.05rem;font-weight:700;color:var(--dark);margin-bottom:.5rem}
    .step p{font-size:.84rem;color:var(--text2);line-height:1.7}

    /* ─── PRICING ─── */
    .pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:3rem;max-width:960px;margin-left:auto;margin-right:auto}
    .plan{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:2.5rem 2rem;transition:all .3s;position:relative}
    .plan:hover{box-shadow:var(--shadow-lg)}
    .plan.featured{border-color:var(--green);box-shadow:0 0 0 1px var(--green),var(--shadow-lg)}
    .plan-badge{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--green);color:#fff;font-size:.58rem;font-weight:800;padding:.3rem 1rem;border-radius:0 0 8px 8px;letter-spacing:1.5px;text-transform:uppercase}
    .plan-name{font-size:.7rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--text3);margin-bottom:.5rem}
    .plan-price{font-size:3rem;font-weight:900;color:var(--dark);line-height:1;margin-bottom:.3rem;letter-spacing:-2px}
    .plan-price span{font-size:.85rem;font-weight:400;color:var(--text3);letter-spacing:0}
    .plan-desc{font-size:.82rem;color:var(--text2);margin-bottom:1.8rem;line-height:1.5}
    .plan-list{list-style:none;display:flex;flex-direction:column;gap:.5rem;margin-bottom:2rem}
    .plan-list li{display:flex;gap:.6rem;font-size:.84rem;color:var(--text2);align-items:flex-start}
    .plan-list .ck{color:var(--green);font-weight:700;flex-shrink:0}
    .plan-list li.off{color:var(--text3)}.plan-list li.off .ck{color:var(--text3)}
    .btn-plan{width:100%;padding:.85rem;border-radius:10px;font-size:.88rem;font-weight:700;cursor:pointer;display:block;text-align:center;transition:all .25s;border:none}
    .btn-plan-green{background:var(--green);color:#fff}
    .btn-plan-green:hover{background:#15803d}
    .btn-plan-outline{background:var(--white);border:1px solid var(--border2);color:var(--text)}
    .btn-plan-outline:hover{border-color:var(--green);color:var(--green)}

    /* ─── TESTIMONIALS ─── */
    .testi-grid{display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;margin-top:3rem}
    .testi{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:2rem;max-width:340px;flex:1;min-width:270px;transition:box-shadow .3s}
    .testi:hover{box-shadow:var(--shadow)}
    .testi-stars{color:var(--green);font-size:.75rem;letter-spacing:2px;margin-bottom:1rem}
    .testi-text{font-size:.88rem;color:var(--text2);line-height:1.75;margin-bottom:1.4rem}
    .testi-author{display:flex;align-items:center;gap:.8rem}
    .testi-av{width:36px;height:36px;border-radius:50%;background:var(--green-bg);border:1px solid var(--green-border);display:flex;align-items:center;justify-content:center;color:var(--green);font-weight:800;font-size:.8rem;flex-shrink:0}
    .testi-name{font-size:.82rem;font-weight:700;color:var(--dark)}
    .testi-role{font-size:.7rem;color:var(--text3)}

    /* ─── FAQ ─── */
    .faq-list{max-width:660px;margin:3rem auto 0;display:flex;flex-direction:column;gap:.5rem}
    .faq-item{background:var(--white);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:border-color .2s}
    .faq-item:hover{border-color:var(--border2)}
    .faq-q{width:100%;background:none;border:none;color:var(--dark);padding:1.2rem 1.4rem;text-align:left;font-size:.88rem;font-weight:600;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:1rem;font-family:'Inter',sans-serif}
    .faq-q:hover{color:var(--green)}
    .faq-arrow{color:var(--text3);font-size:.85rem;flex-shrink:0;transition:transform .3s,color .3s}
    .faq-a{padding:0 1.4rem 1.2rem;color:var(--text2);font-size:.84rem;line-height:1.75;display:none}
    .faq-item.open .faq-a{display:block}
    .faq-item.open .faq-arrow{transform:rotate(180deg);color:var(--green)}

    /* ─── CTA ─── */
    .cta{text-align:center;padding:100px 6%;background:linear-gradient(180deg,var(--white) 0%,#f0fdf4 100%)}
    .cta h2{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;letter-spacing:-1.5px;margin-bottom:1rem;color:var(--dark)}
    .cta h2 em{font-style:normal;color:var(--green)}
    .cta p{color:var(--text2);font-size:.95rem;margin-bottom:2.5rem}

    /* ─── FOOTER ─── */
    footer{border-top:1px solid var(--border);padding:3rem 6% 2rem;background:var(--bg)}
    .footer-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:2rem;margin-bottom:2rem}
    .footer-brand p{font-size:.78rem;color:var(--text3);max-width:260px;line-height:1.6;margin-top:.5rem}
    .footer-col h4{font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text2);margin-bottom:.7rem}
    .footer-col a{display:block;color:var(--text3);font-size:.8rem;margin-bottom:.4rem;transition:color .2s}
    .footer-col a:hover{color:var(--green)}
    .footer-bottom{border-top:1px solid var(--border);padding-top:1.5rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
    .footer-bottom p{font-size:.72rem;color:var(--text3)}

    /* ─── RESPONSIVE ─── */
    @media(max-width:768px){
      nav{padding:0 4%}
      .nav-links{display:none}
      section{padding:70px 4%}
      .hero{padding:120px 4% 60px}
      .split{flex-direction:column!important}
      .pricing-grid{grid-template-columns:1fr}
      .hm-tabs{flex-wrap:wrap;gap:4px}
      .hm-tab{font-size:.68rem;padding:5px 10px}
      .hm-pipeline{flex-direction:column}
      .footer-top{flex-direction:column}
      .footer-bottom{flex-direction:column;text-align:center}
    }
  </style>
</head>
<body>

<!-- ─── NAV ─── -->
<nav id="nav">
  <a href="/" class="logo"><span class="logo-dark">EMPIRE</span>&nbsp;<span class="logo-green">LEADS</span></a>
  <div class="nav-links">
    <a href="#fonctionnalites">Produit</a>
    <a href="#roi">Calculateur ROI</a>
    <a href="#tarifs">Tarifs</a>
    <a href="#faq">FAQ</a>
  </div>
  <div class="nav-right">
    <a href="/login" class="btn-s btn-ghost">Connexion</a>
    <a href="/login" class="btn-s btn-green">Démarrer</a>
    <button class="nav-burger" id="navBurger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="nav-mobile" id="navMobile">
  <a href="#fonctionnalites">Produit</a>
  <a href="#roi">Calculateur ROI</a>
  <a href="#tarifs">Tarifs</a>
  <a href="#faq">FAQ</a>
  <a href="/login" class="nm-cta">Démarrer gratuitement →</a>
</div>
<style>
  .nav-burger{display:none;width:38px;height:38px;background:transparent;border:1px solid var(--border);border-radius:10px;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:4px;transition:all .2s}
  .nav-burger span{display:block;width:16px;height:2px;background:var(--dark);border-radius:2px;transition:all .3s}
  .nav-burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .nav-burger.open span:nth-child(2){opacity:0}
  .nav-burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
  .nav-mobile{position:fixed;top:68px;left:0;right:0;background:rgba(255,255,255,.98);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:1.5rem 6%;display:none;flex-direction:column;gap:1rem;z-index:99;box-shadow:0 10px 30px rgba(0,0,0,.08)}
  .nav-mobile.open{display:flex;animation:nmSlide .3s ease both}
  @keyframes nmSlide{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  .nav-mobile a{color:var(--text);font-size:1rem;font-weight:600;padding:.5rem 0;border-bottom:1px solid var(--border)}
  .nav-mobile a:hover{color:var(--green)}
  .nav-mobile .nm-cta{background:var(--green);color:#fff!important;text-align:center;padding:.9rem;border-radius:10px;border:none;font-weight:700;margin-top:.5rem}
  @media(max-width:768px){
    .nav-burger{display:flex}
    .nav-links{display:none}
    .nav-right .btn-s{display:none}
  }
</style>
<script>
  (function(){
    var b=document.getElementById('navBurger');
    var m=document.getElementById('navMobile');
    if(!b||!m)return;
    b.addEventListener('click',function(){b.classList.toggle('open');m.classList.toggle('open')});
    m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){b.classList.remove('open');m.classList.remove('open')})});
  })();
</script>

<!-- ─── HERO ─── -->
<section class="hero" id="hero-section">
  <!-- VIDEO BACKGROUND SLOT — depose ton MP4 dans /public/video/hero.mp4 pour l'activer -->
  <div class="hero-video-wrap" aria-hidden="true">
    <video class="hero-video" id="hero-video" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg">
      <source src="/video/hero.mp4" type="video/mp4">
      <source src="/video/hero.webm" type="video/webm">
    </video>
    <div class="hero-video-overlay"></div>
  </div>
  <div class="hero-inner">
    <h1>Votre machine à<br>trouver des <em>clients B2B.</em></h1>
    <p class="hero-desc">Empire Leads détecte chaque jour les commerces <strong>sans site ni réseaux</strong>. Téléphone, email, décideur — directement dans ton CRM, avec un pitch IA prêt à envoyer.</p>
    <div class="hero-actions">
      <a href="/login" class="btn-hero btn-hero-green">Démarrer gratuitement</a>
      <a href="#fonctionnalites" class="btn-hero btn-hero-outline">Découvrir le produit</a>
    </div>
    <p class="hero-sub">Aucune carte de crédit requise.<span>|</span>Annulation à tout moment.<span>|</span>Support en français.</p>
  </div>
</section>

<div class="sep"></div>

<!-- ─── COMMENT CA MARCHE ─── -->
<section class="steps-section">
  <div class="steps-card">
    <div class="steps-bg"></div>
    <div class="steps-shine"></div>
    <div class="steps-header">
      <span class="steps-label">Comment ça marche</span>
      <h2 class="steps-title">3 étapes.<br><em>Zéro friction.</em></h2>
    </div>
    <div class="steps-row">
      <div class="steps-item">
        <div class="steps-num-wrap">
          <span class="steps-num">01</span>
          <span class="steps-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </span>
          <span class="steps-line"></span>
        </div>
        <h3 class="steps-h">Recherche en 10 secondes</h3>
        <p class="steps-p">Tape un secteur + une ville. Empire scanne Google Maps et sort des milliers de commerces avec téléphone, email, décideur.</p>
      </div>
      <div class="steps-item">
        <div class="steps-num-wrap">
          <span class="steps-num">02</span>
          <span class="steps-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 21 6 14 14 14 20 10 20 10 14 3 6"/></svg>
          </span>
          <span class="steps-line"></span>
        </div>
        <h3 class="steps-h">Filtre les pépites</h3>
        <p class="steps-p">Affiche uniquement les entreprises sans site ni réseaux. Zéro concurrence, zéro pollution — que des vrais besoins.</p>
      </div>
      <div class="steps-item">
        <div class="steps-num-wrap">
          <span class="steps-num">03</span>
          <span class="steps-ico">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          <span class="steps-line"></span>
        </div>
        <h3 class="steps-h">Signe avant vendredi</h3>
        <p class="steps-p">Pipeline CRM intégré, pitch IA généré en 1 clic. Tu envoies, tu relances, tu signes — tout est au même endroit.</p>
      </div>
    </div>
    <div class="steps-cta">
      <div class="steps-cta-text">
        <strong>En moins de 2 minutes, ta première liste de prospects est prête.</strong>
        <p>Essai gratuit. Aucune carte bancaire requise.</p>
      </div>
      <a href="/login" class="steps-cta-btn">Démarrer<span class="sc-arrow">→</span></a>
    </div>
  </div>
</section>

<!-- ─── LOGOS CLIENTS (trust bar) ─── -->
<section class="logos-section">
  <p class="logos-lead">Déjà adopté par des agences, freelances et consultants aux quatre coins de la France</p>
  <div class="logos-marquee">
    <div class="logos-track">
      <div class="logo-item"><span class="logo-txt">Altitude Studio</span></div>
      <div class="logo-item"><span class="logo-txt">Nova Digital</span></div>
      <div class="logo-item"><span class="logo-txt">Atelier Onze</span></div>
      <div class="logo-item"><span class="logo-txt">Kairos Agency</span></div>
      <div class="logo-item"><span class="logo-txt">Pixelflow</span></div>
      <div class="logo-item"><span class="logo-txt">Maison Verte</span></div>
      <div class="logo-item"><span class="logo-txt">Signal &amp; Co</span></div>
      <div class="logo-item"><span class="logo-txt">Brume Studio</span></div>
      <div class="logo-item"><span class="logo-txt">Forge Commerce</span></div>
      <!-- Duplicate for loop -->
      <div class="logo-item"><span class="logo-txt">Altitude Studio</span></div>
      <div class="logo-item"><span class="logo-txt">Nova Digital</span></div>
      <div class="logo-item"><span class="logo-txt">Atelier Onze</span></div>
      <div class="logo-item"><span class="logo-txt">Kairos Agency</span></div>
      <div class="logo-item"><span class="logo-txt">Pixelflow</span></div>
      <div class="logo-item"><span class="logo-txt">Maison Verte</span></div>
      <div class="logo-item"><span class="logo-txt">Signal &amp; Co</span></div>
      <div class="logo-item"><span class="logo-txt">Brume Studio</span></div>
      <div class="logo-item"><span class="logo-txt">Forge Commerce</span></div>
    </div>
  </div>
</section>

<style>
  .logos-section{padding:60px 6%;background:var(--white);border-bottom:1px solid var(--border)}
  .logos-lead{text-align:center;font-size:.78rem;color:var(--text3);font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:2.2rem}
  .logos-marquee{overflow:hidden;mask-image:linear-gradient(90deg,transparent 0%,#000 8%,#000 92%,transparent 100%);-webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 8%,#000 92%,transparent 100%)}
  .logos-track{display:flex;gap:3rem;width:max-content;animation:logosScroll 40s linear infinite;align-items:center}
  @keyframes logosScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .logo-item{flex-shrink:0;font-family:'Switzer','Satoshi',sans-serif;font-size:1.35rem;font-weight:800;color:var(--text3);letter-spacing:-.5px;opacity:.55;transition:opacity .3s,color .3s}
  .logo-item:hover{opacity:1;color:var(--green)}
</style>

<!-- ─── AVANT / APRÈS (comparaison ancien monde vs Empire) ─── -->
<section class="vs-section">
  <div class="centered" style="margin-bottom:3rem">
    <span class="sec-label">Avant / Après</span>
    <h2 class="sec-title">La prospection, <em>version 2026</em>.</h2>
    <p class="sec-desc">Stop aux bases froides Excel et au scrolling LinkedIn sans fin. Il y a une meilleure façon.</p>
  </div>
  <div class="vs-wrap">
    <div class="vs-card vs-bad">
      <div class="vs-head">
        <span class="vs-tag vs-tag-bad">L'ancien monde</span>
        <h3>Prospection manuelle</h3>
      </div>
      <ul class="vs-list">
        <li><span class="vs-ic vs-ic-bad">×</span>Scroll LinkedIn 3h pour trouver 10 prospects</li>
        <li><span class="vs-ic vs-ic-bad">×</span>Excel multi-onglets et contacts perdus</li>
        <li><span class="vs-ic vs-ic-bad">×</span>Messages copiés-collés, taux de réponse 2%</li>
        <li><span class="vs-ic vs-ic-bad">×</span>Base vieille de 6 mois, moitié hors-service</li>
        <li><span class="vs-ic vs-ic-bad">×</span>Concurrence directe sur les leads évidents</li>
        <li><span class="vs-ic vs-ic-bad">×</span>Relances oubliées, deals qui fuitent</li>
      </ul>
      <div class="vs-footer">Résultat : 1 client signé par mois, au mieux.</div>
    </div>
    <div class="vs-arrow" aria-hidden="true">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </div>
    <div class="vs-card vs-good">
      <div class="vs-head">
        <span class="vs-tag vs-tag-good">Avec Empire Leads</span>
        <h3>Prospection automatisée</h3>
      </div>
      <ul class="vs-list">
        <li><span class="vs-ic vs-ic-good">✓</span>1000 prospects qualifiés en 20 secondes</li>
        <li><span class="vs-ic vs-ic-good">✓</span>CRM pipeline visuel, tout au même endroit</li>
        <li><span class="vs-ic vs-ic-good">✓</span>Pitch IA personnalisé, taux de réponse 15%+</li>
        <li><span class="vs-ic vs-ic-good">✓</span>Données fraîches, mises à jour en continu</li>
        <li><span class="vs-ic vs-ic-good">✓</span>Angle mort du marché : commerces sans site</li>
        <li><span class="vs-ic vs-ic-good">✓</span>Rappels auto, aucun deal n'échappe</li>
      </ul>
      <div class="vs-footer vs-footer-good">Résultat : 3 à 8 clients signés par mois.</div>
    </div>
  </div>
</section>

<style>
  .vs-section{padding:90px 6%;background:var(--white)}
  .vs-wrap{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;gap:1.5rem;align-items:stretch}
  .vs-card{padding:2.2rem 2rem;border-radius:22px;display:flex;flex-direction:column;height:100%;border:1px solid var(--border);background:var(--white)}
  .vs-bad{background:linear-gradient(180deg,#fefefe 0%,#fafafa 100%);opacity:.88}
  .vs-good{background:linear-gradient(165deg,#ecfdf5 0%,#d1fae5 100%);border-color:rgba(22,163,74,.2);box-shadow:0 25px 60px -20px rgba(22,163,74,.25)}
  .vs-head{margin-bottom:1.5rem}
  .vs-tag{display:inline-block;font-size:.62rem;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;padding:.35rem .85rem;border-radius:999px;margin-bottom:.9rem}
  .vs-tag-bad{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
  .vs-tag-good{background:rgba(22,163,74,.12);color:#047857;border:1px solid rgba(22,163,74,.25)}
  .vs-head h3{font-family:'Switzer','Satoshi',sans-serif;font-size:1.8rem;font-weight:800;letter-spacing:-1px;color:#052e16}
  .vs-bad h3{color:#52525b}
  .vs-list{list-style:none;display:flex;flex-direction:column;gap:.85rem;margin-bottom:1.8rem;flex:1}
  .vs-list li{display:flex;gap:.75rem;align-items:flex-start;font-size:.92rem;line-height:1.55}
  .vs-bad .vs-list li{color:#71717a;text-decoration:line-through;text-decoration-thickness:1px;text-decoration-color:rgba(113,113,122,.4)}
  .vs-good .vs-list li{color:#14532d;font-weight:500}
  .vs-ic{flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;font-size:.75rem;font-weight:900;margin-top:1px}
  .vs-ic-bad{background:#fee2e2;color:#dc2626;border:1px solid #fecaca}
  .vs-ic-good{background:#16a34a;color:#fff}
  .vs-footer{font-size:.85rem;font-weight:700;color:#dc2626;padding-top:1.2rem;border-top:1px solid rgba(220,38,38,.15)}
  .vs-footer-good{color:#047857;border-top-color:rgba(22,163,74,.2)}
  .vs-arrow{display:flex;align-items:center;justify-content:center;color:var(--green)}
  @media(max-width:900px){
    .vs-wrap{grid-template-columns:1fr;gap:1rem}
    .vs-arrow{transform:rotate(90deg);padding:1rem 0}
  }
</style>

<style>
  .steps-section{padding:90px 6% 110px;background:linear-gradient(180deg,#f0fdf4 0%,#ffffff 100%)}
  .steps-card{position:relative;max-width:1180px;margin:0 auto;background:linear-gradient(160deg,#ecfdf5 0%,#d1fae5 45%,#a7f3d0 100%);border-radius:32px;padding:3.5rem 3rem 2rem;overflow:hidden;box-shadow:0 40px 80px -20px rgba(22,163,74,.25),0 0 0 1px rgba(22,163,74,.08),inset 0 1px 0 rgba(255,255,255,.6)}
  .steps-bg{position:absolute;inset:0;pointer-events:none;opacity:.7;background:radial-gradient(ellipse 900px 400px at 85% -10%,rgba(22,163,74,.35) 0%,transparent 50%),radial-gradient(ellipse 700px 500px at 10% 110%,rgba(5,150,105,.25) 0%,transparent 55%)}
  .steps-shine{position:absolute;top:-50%;left:-20%;width:80%;height:200%;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.35) 50%,transparent 60%);pointer-events:none;transform:rotate(8deg)}
  .steps-card > *{position:relative;z-index:1}
  .steps-header{margin-bottom:3.5rem;max-width:620px}
  .steps-label{display:inline-block;font-size:.65rem;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:#047857;background:rgba(255,255,255,.55);padding:.4rem .9rem;border-radius:999px;border:1px solid rgba(22,163,74,.18);margin-bottom:1.2rem;backdrop-filter:blur(8px)}
  .steps-title{font-size:clamp(2.2rem,4.5vw,3.6rem);font-weight:900;color:#052e16;letter-spacing:-2px;line-height:1.02}
  .steps-title em{font-style:normal;background:linear-gradient(90deg,#047857 0%,#10b981 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .steps-row{display:grid;grid-template-columns:repeat(3,1fr);gap:2.8rem;margin-bottom:2.5rem}
  .steps-item{display:flex;flex-direction:column;position:relative}
  .steps-num-wrap{display:flex;align-items:center;gap:.9rem;margin-bottom:1.6rem;min-height:56px}
  .steps-num{font-size:2.8rem;font-weight:900;color:#052e16;line-height:1;letter-spacing:-2.5px;font-variant-numeric:tabular-nums;opacity:.9}
  .steps-ico{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:12px;background:rgba(255,255,255,.75);border:1px solid rgba(22,163,74,.22);color:#047857;backdrop-filter:blur(8px);box-shadow:0 6px 16px rgba(22,163,74,.12)}
  .steps-ico svg{width:18px;height:18px}
  .steps-line{flex:1;height:1px;background:linear-gradient(90deg,rgba(5,46,22,.25) 0%,rgba(5,46,22,0) 100%)}
  .steps-h{font-size:1.18rem;font-weight:800;color:#052e16;margin-bottom:.7rem;letter-spacing:-.4px;line-height:1.22}
  .steps-p{font-size:.93rem;color:#14532d;line-height:1.65;opacity:.82}
  .steps-cta{display:flex;justify-content:space-between;align-items:center;gap:2rem;background:rgba(255,255,255,.6);backdrop-filter:blur(14px);border:1px solid rgba(22,163,74,.18);border-radius:20px;padding:1.5rem 1.9rem;margin-top:1.5rem;box-shadow:0 10px 30px rgba(22,163,74,.08)}
  .steps-cta-text strong{display:block;font-size:1.04rem;font-weight:800;color:#052e16;letter-spacing:-.3px;margin-bottom:.25rem}
  .steps-cta-text p{font-size:.82rem;color:#14532d;opacity:.72}
  .steps-cta-btn{display:inline-flex;align-items:center;gap:.6rem;background:#052e16;color:#fff;padding:1rem 1.9rem;border-radius:999px;font-weight:700;font-size:.94rem;transition:all .3s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;box-shadow:0 8px 24px rgba(5,46,22,.35)}
  .steps-cta-btn:hover{background:#14532d;transform:translateY(-2px);box-shadow:0 14px 32px rgba(5,46,22,.45)}
  .sc-arrow{transition:transform .3s}
  .steps-cta-btn:hover .sc-arrow{transform:translateX(4px)}
  @media(max-width:768px){
    .steps-card{padding:2.5rem 1.5rem 1.5rem;border-radius:24px}
    .steps-row{grid-template-columns:1fr;gap:2.2rem;margin-bottom:1.8rem}
    .steps-num{font-size:2.4rem}
    .steps-cta{flex-direction:column;align-items:stretch;text-align:center;padding:1.3rem}
    .steps-cta-btn{justify-content:center}
  }
</style>

<div class="sep"></div>

<!-- ─── FEATURES ─── -->
<section id="fonctionnalites" class="ft-section">
  <div class="centered" style="margin-bottom:2.5rem">
    <span class="sec-label">Fonctionnalités</span>
    <h2 class="sec-title">Tout l'arsenal de prospection<br>dans une seule app</h2>
  </div>

  <div class="ft-tabs" role="tablist">
    <button class="ft-tab active" data-tab="0">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      Recherche
    </button>
    <button class="ft-tab" data-tab="1">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      Pipeline CRM
    </button>
    <button class="ft-tab" data-tab="2">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1.5"/></svg>
      Instagram Finder
    </button>
    <button class="ft-tab" data-tab="3">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      Leads Chauds
    </button>
    <button class="ft-tab" data-tab="4">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
      Pitch IA
    </button>
    <button class="ft-tab" data-tab="5">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      Email Finder
    </button>
  </div>

  <div class="ft-panels">
    <!-- PANEL 0 - Recherche -->
    <div class="ft-panel active" data-panel="0">
      <div class="ft-text">
        <h3>Scanne 1000 commerces<br>en 20 secondes</h3>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <div><h4>Moteur Google Maps + CSE</h4><p>Interroge en temps réel les bases Google Maps, Societe.com et annuaires locaux.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg></div>
          <div><h4>Filtres "sans site" / "sans réseaux"</h4><p>Isole uniquement les entreprises invisibles en ligne — zéro concurrence.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
          <div><h4>Export CSV illimité</h4><p>Télécharge ta liste ou pousse-la direct dans ton CRM Empire.</p></div>
        </div>
      </div>
      <div class="ft-visual">
        <div class="ft-orbit">
          <div class="ft-orbit-core"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></div>
          <span class="ft-node" style="--x:-120px;--y:-100px">Google Maps</span>
          <span class="ft-node" style="--x:130px;--y:-110px">Pages Jaunes</span>
          <span class="ft-node" style="--x:170px;--y:30px">Societe.com</span>
          <span class="ft-node" style="--x:80px;--y:150px">Instagram</span>
          <span class="ft-node" style="--x:-130px;--y:130px">Yelp</span>
          <span class="ft-node" style="--x:-180px;--y:20px">Foursquare</span>
          <div class="ft-ring"></div>
          <div class="ft-ring ft-ring-2"></div>
        </div>
      </div>
    </div>

    <!-- PANEL 1 - CRM -->
    <div class="ft-panel" data-panel="1">
      <div class="ft-text">
        <h3>Signe sans rien perdre<br>en route</h3>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
          <div><h4>Pipeline 6 étapes</h4><p>Cold call, à rappeler, RDV, proposition, signé, perdu. Tout au même endroit.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          <div><h4>Relances automatiques</h4><p>Alerte + notification quand un prospect doit être rappelé. Rien ne tombe.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
          <div><h4>Stats de closing</h4><p>Taux de conversion, CA mensuel, temps moyen de signature — en temps réel.</p></div>
        </div>
      </div>
      <div class="ft-visual">
        <div class="ft-orbit">
          <div class="ft-orbit-core"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></div>
          <span class="ft-node" style="--x:-150px;--y:-90px">Cold Call</span>
          <span class="ft-node" style="--x:130px;--y:-110px">A rappeler</span>
          <span class="ft-node" style="--x:180px;--y:30px">Rendez-vous</span>
          <span class="ft-node ft-node-won" style="--x:80px;--y:150px">Signe</span>
          <span class="ft-node" style="--x:-130px;--y:130px">Proposition</span>
          <span class="ft-node" style="--x:-180px;--y:20px">Perdu</span>
          <div class="ft-ring"></div>
          <div class="ft-ring ft-ring-2"></div>
        </div>
      </div>
    </div>

    <!-- PANEL 2 - Instagram -->
    <div class="ft-panel" data-panel="2">
      <div class="ft-text">
        <h3>Extrais l'audience de<br>n'importe quel compte</h3>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg></div>
          <div><h4>Commentateurs & followers</h4><p>Extrait en 2 clics tous les comptes qui commentent ou suivent une cible.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
          <div><h4>Filtrage FR + email</h4><p>Ne garde que les français actifs avec email en bio. Prospection chirurgicale.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg></div>
          <div><h4>Bookmarklet 1-clic</h4><p>Installe le code sur ton navigateur, tourne direct sur instagram.com sans limite.</p></div>
        </div>
      </div>
      <div class="ft-visual">
        <div class="ft-orbit">
          <div class="ft-orbit-core" style="background:linear-gradient(135deg,#833AB4,#E1306C,#F77737)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="18" cy="6" r="1.5"/></svg></div>
          <span class="ft-node" style="--x:-140px;--y:-100px">@marie.fitness</span>
          <span class="ft-node" style="--x:140px;--y:-110px">@alex.coach</span>
          <span class="ft-node" style="--x:170px;--y:30px">@julien.pro</span>
          <span class="ft-node" style="--x:80px;--y:150px">@sophie.yoga</span>
          <span class="ft-node" style="--x:-130px;--y:130px">@lucas.fit</span>
          <span class="ft-node" style="--x:-180px;--y:20px">@emma.health</span>
          <div class="ft-ring"></div>
          <div class="ft-ring ft-ring-2"></div>
        </div>
      </div>
    </div>

    <!-- PANEL 3 - Leads Chauds -->
    <div class="ft-panel" data-panel="3">
      <div class="ft-text">
        <h3>Des prospects qui cherchent<br>déjà un prestataire</h3>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <div><h4>Flux temps réel</h4><p>Projets actifs mis à jour en continu — site vitrine, e-commerce, WordPress, mobile.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
          <div><h4>Budget affiché</h4><p>Chaque projet affiche sa fourchette budgétaire — tu sais où cibler.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="16 12 12 8 8 12"/><line x1="12" y1="16" x2="12" y2="8"/></svg></div>
          <div><h4>Tri par urgence</h4><p>Badge "Urgent" sur les projets à fort potentiel de signature rapide.</p></div>
        </div>
      </div>
      <div class="ft-visual">
        <div class="ft-orbit">
          <div class="ft-orbit-core" style="background:linear-gradient(135deg,#dc2626,#f97316)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <span class="ft-node" style="--x:-140px;--y:-100px">Site vitrine</span>
          <span class="ft-node" style="--x:140px;--y:-110px">E-commerce</span>
          <span class="ft-node" style="--x:170px;--y:30px">WordPress</span>
          <span class="ft-node ft-node-hot" style="--x:80px;--y:150px">App mobile</span>
          <span class="ft-node" style="--x:-130px;--y:130px">Refonte</span>
          <span class="ft-node" style="--x:-180px;--y:20px">SEO</span>
          <div class="ft-ring"></div>
          <div class="ft-ring ft-ring-2"></div>
        </div>
      </div>
    </div>

    <!-- PANEL 4 - Pitch IA -->
    <div class="ft-panel" data-panel="4">
      <div class="ft-text">
        <h3>Un pitch personnalisé<br>en 1 seul clic</h3>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/></svg></div>
          <div><h4>IA spécialisée B2B</h4><p>Analyse le profil du prospect et génère un message qui parle VRAIMENT à sa situation.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></div>
          <div><h4>Réglages de ton</h4><p>Formel, direct, chaleureux. Adapte le style selon la niche et le secteur.</p></div>
        </div>
        <div class="ft-feat">
          <div class="ft-feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
          <div><h4>Variantes illimitées</h4><p>Régénère autant de versions que tu veux jusqu'à trouver celle qui claque.</p></div>

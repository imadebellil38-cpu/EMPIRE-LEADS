<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Empire Leads — Logiciel de prospection B2B · Leads qualifiés, CRM, IA</title>
  <meta name="description" content="Logiciel de prospection B2B qui identifie les commerces sans site web. Téléphone, email, décideur dans un CRM avec pitch IA. À partir de 99 €/mois.">
  <meta name="keywords" content="empire leads, prospection B2B, logiciel prospection, leads qualifiés, CRM prospection, trouver prospects, entreprises sans site web, Instagram finder, email finder, pitch IA, prospection commerciale France">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-image-preview:large">

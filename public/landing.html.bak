  .cta-big-h em{font-style:normal;color:#4ade80}
  .cta-big-h .scribble::after{height:.32em}
  .cta-big-btn{max-width:340px;margin:0 auto 1rem;color:#08110c!important}
  .cta-big-btn .offer-btn-circle{background:linear-gradient(135deg,#16a34a,#065f46)}
  .cta-secure{display:inline-flex;align-items:center;gap:.5rem;font-size:.78rem;color:rgba(255,255,255,.55);font-weight:500;margin-top:.5rem}
  .cta-giant-logo{margin:5rem auto 0;display:flex;justify-content:center;align-items:center;gap:.3rem;font-family:'Satoshi','Inter',sans-serif;font-weight:900;font-size:clamp(4rem,16vw,13rem);letter-spacing:-8px;line-height:.9;position:relative;z-index:1;padding-bottom:.1em;user-select:none}
  .cta-giant-logo .cgl-dark{background:linear-gradient(180deg,rgba(255,255,255,.08) 0%,rgba(255,255,255,.02) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;color:transparent;text-shadow:none}
  .cta-giant-logo .cgl-green{background:linear-gradient(180deg,rgba(22,163,74,.35) 0%,rgba(22,163,74,.05) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;color:transparent;margin-left:.2em}
